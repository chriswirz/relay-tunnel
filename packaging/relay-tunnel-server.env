# Configuration for the relay-tunnel rendezvous server (systemd).
# Edit and then: systemctl restart relay-tunnel-server

# Config file. The admin web interface writes the administrator account back to
# it, so it must stay writable by the relay-tunnel user; the packaged unit
# allows exactly this path. The package creates it as an empty {} on install.
RT_CONFIG=/etc/relay-tunnel/config.json

# WebSocket signaling listen address (TCP). This port also serves the admin web
# interface, unless RT_EXTRA_ARGS turns it off with --admin=false.
RT_HTTP_ADDR=:7000

# UDP reflection/relay listen address.
RT_UDP_ADDR=:7001

# Extra arguments passed verbatim, e.g. advertise a public UDP address when
# behind NAT/a load balancer, or enable verbose logging:
#   RT_EXTRA_ARGS=--public-udp your.host.example:7001 -v
# or turn the admin web interface off entirely:
#   RT_EXTRA_ARGS=--admin=false
RT_EXTRA_ARGS=
